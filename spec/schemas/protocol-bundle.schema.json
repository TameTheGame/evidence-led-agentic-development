{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elad:schema:protocol-bundle:0.4.0",
  "title": "Protocol Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "protocolId",
    "version",
    "state",
    "framing",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": "0.4.0" },
    "bundleId": { "type": "string", "pattern": "^protocol-bundle:[a-z0-9][a-z0-9._-]*$" },
    "protocolId": { "type": "string", "pattern": "^protocol:[a-z0-9][a-z0-9._-]*$" },
    "version": { "const": "0.4.0" },
    "state": { "enum": ["template_inert", "reference_only", "released", "superseded"] },
    "framing": { "const": "elad-protocol-bundle-v1" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "artifactClass", "digestMode", "bytes", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/repositoryPath" },
          "artifactClass": {
            "enum": ["protocol_root", "version_marker", "schema", "registry", "conformance_oracle"]
          },
          "digestMode": { "enum": ["canonical_json", "raw_bytes"] },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*:)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?(?:/|$))[^/\\x00-\\x1F<>\"|?*]+(?:/[^/\\x00-\\x1F<>\"|?*]+)*$"
    }
  }
}
