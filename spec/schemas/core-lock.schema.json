{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elad:schema:core-lock:0.5",
  "title": "Core Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lockId",
    "state",
    "ownerRepositoryId",
    "blueprint",
    "protocolBundle",
    "targetCompatibility",
    "approvedBy",
    "approvedAt",
    "supersedes"
  ],
  "properties": {
    "schemaVersion": { "const": "0.5" },
    "lockId": { "type": "string", "pattern": "^core-lock:[a-z0-9][a-z0-9._-]*$" },
    "state": { "enum": ["template_inert", "approved", "superseded"] },
    "ownerRepositoryId": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._-]*$" },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "protocolId",
        "distributionIdentity",
        "sourceCommit",
        "distributionSha256"
      ],
      "properties": {
        "name": { "const": "Evidence-Led Agentic Development" },
        "version": { "const": "0.5" },
        "protocolId": { "const": "protocol:elad_0.5" },
        "distributionIdentity": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "distributionSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "protocolBundle": { "$ref": "#/$defs/immutableReference" },
    "targetCompatibility": { "enum": ["not_evaluated", "compatible", "incompatible"] },
    "approvedBy": { "type": ["string", "null"], "pattern": "^human:[a-z0-9][a-z0-9._-]*$" },
    "approvedAt": { "type": ["string", "null"], "format": "date-time" },
    "supersedes": { "$ref": "#/$defs/optionalImmutableReference" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*:)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?(?:/|$))[^/\\x00-\\x1F<>\"|?*]+(?:/[^/\\x00-\\x1F<>\"|?*]+)*$"
    },
    "immutableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^protocol-bundle:[a-z0-9][a-z0-9._-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "const": "0.5" }
      }
    },
    "optionalImmutableReference": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^core-lock:[a-z0-9][a-z0-9._-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "const": "0.5" }
      }
    }
  }
}
