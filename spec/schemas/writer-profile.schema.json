{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elad:schema:writer-profile:0.5",
  "title": "Writer Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "state",
    "modelSubject",
    "executionLocation",
    "identityBindings",
    "roles",
    "configuredBudgets",
    "mutationCeiling",
    "knownFailures"
  ],
  "properties": {
    "schemaVersion": { "const": "0.5" },
    "profileId": { "type": "string", "pattern": "^writer:[a-z0-9][a-z0-9._-]*$" },
    "state": { "enum": ["unqualified", "shadow", "canary", "candidate_only", "qualified", "narrowed", "expired", "revoked"] },
    "modelSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "artifactSha256", "artifactSha256NullReason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "artifactSha256": { "type": ["string", "null"], "pattern": "^[A-F0-9]{64}$" },
        "artifactSha256NullReason": { "type": ["string", "null"] }
      }
    },
    "executionLocation": { "enum": ["cloud", "local", "isolated_local"] },
    "identityBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "harness", "adapter", "promptTemplate", "toolSchema", "protocolBundle"],
      "properties": {
        "runtime": { "$ref": "#/$defs/immutableReference" },
        "harness": { "$ref": "#/$defs/immutableReference" },
        "adapter": { "$ref": "#/$defs/immutableReference" },
        "promptTemplate": { "$ref": "#/$defs/immutableReference" },
        "toolSchema": { "$ref": "#/$defs/immutableReference" },
        "protocolBundle": { "$ref": "#/$defs/immutableReference" }
      }
    },
    "roles": {
      "type": "array",
      "items": { "type": "string", "pattern": "^role:[a-z0-9][a-z0-9._-]*$" },
      "uniqueItems": true,
      "minItems": 1
    },
    "configuredBudgets": { "$ref": "#/$defs/budgets" },
    "mutationCeiling": { "enum": ["read_only", "candidate_only", "target_operation"] },
    "knownFailures": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*:)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?(?:/|$))[^/\\x00-\\x1F<>\"|?*]+(?:/[^/\\x00-\\x1F<>\"|?*]+)*$"
    },
    "immutableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextTokens", "outputTokens", "retrievals", "sequentialToolCalls", "totalToolCalls", "attempts", "spawns", "wallSeconds", "maxCostUsd", "resourceEnvelope"],
      "properties": {
        "contextTokens": { "type": "integer", "minimum": 1 },
        "outputTokens": { "type": "integer", "minimum": 1 },
        "retrievals": { "type": "integer", "minimum": 0 },
        "sequentialToolCalls": { "type": "integer", "minimum": 0 },
        "totalToolCalls": { "type": "integer", "minimum": 0 },
        "attempts": { "type": "integer", "minimum": 0 },
        "spawns": { "type": "integer", "minimum": 0 },
        "wallSeconds": { "type": "integer", "minimum": 1 },
        "maxCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "resourceEnvelope": { "type": "string", "pattern": "^resource-envelope:[a-z0-9][a-z0-9._-]*$" }
      }
    }
  }
}
