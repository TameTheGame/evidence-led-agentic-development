{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elad:schema:worker-receipt:0.5",
  "title": "Worker Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "recordState",
    "recordedAt",
    "supersedes",
    "packet",
    "bindings",
    "riskClass",
    "dataClass",
    "taskFamily",
    "artifactLane",
    "requestedEffects",
    "writer",
    "terminalStatus",
    "candidate",
    "changedPaths",
    "claims",
    "evidenceManifest",
    "openHumanClaims",
    "metrics",
    "firstCausalFailure",
    "finalizationState",
    "requestedNextAction"
  ],
  "properties": {
    "schemaVersion": { "const": "0.5" },
    "receiptId": { "type": "string", "pattern": "^receipt:[a-z0-9][a-z0-9._-]*$" },
    "recordState": { "enum": ["template_inert", "sealed"] },
    "recordedAt": { "type": ["string", "null"], "format": "date-time" },
    "supersedes": { "$ref": "#/$defs/optionalImmutableReference" },
    "packet": { "$ref": "#/$defs/immutableReference" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolBundle", "intent", "projectProfile", "authority", "riskPolicy", "dataPolicy", "evidencePolicy", "toolRegistry", "evaluatorRegistry"],
      "properties": {
        "protocolBundle": { "$ref": "#/$defs/immutableReference" },
        "intent": { "$ref": "#/$defs/immutableReference" },
        "projectProfile": { "$ref": "#/$defs/immutableReference" },
        "authority": { "$ref": "#/$defs/immutableReference" },
        "riskPolicy": { "$ref": "#/$defs/immutableReference" },
        "dataPolicy": { "$ref": "#/$defs/immutableReference" },
        "evidencePolicy": { "$ref": "#/$defs/immutableReference" },
        "toolRegistry": { "$ref": "#/$defs/immutableReference" },
        "evaluatorRegistry": { "$ref": "#/$defs/immutableReference" }
      }
    },
    "riskClass": { "enum": ["low", "normal", "high", "critical"] },
    "dataClass": { "enum": ["public", "internal", "private_local", "restricted"] },
    "taskFamily": { "type": "string", "minLength": 1 },
    "artifactLane": { "enum": ["ordinary_source", "target_native", "runtime", "external_human"] },
    "requestedEffects": { "type": "array", "items": { "enum": ["read", "candidate_write", "target_native_write", "runtime_process", "data_write"] }, "uniqueItems": true, "minItems": 1 },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "certificate"],
      "properties": {
        "profile": { "$ref": "#/$defs/immutableReference" },
        "certificate": { "$ref": "#/$defs/immutableReference" }
      }
    },
    "terminalStatus": { "enum": ["COMPLETE", "NEED_CONTEXT", "EVIDENCE_FAILED", "OUT_OF_SCOPE", "ESCALATE"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "candidateId", "candidateSha256", "baseHead", "head"],
      "properties": {
        "state": { "enum": ["unchanged", "checkpointed", "finalized"] },
        "candidateId": { "type": "string", "pattern": "^candidate:[a-z0-9][a-z0-9._-]*$" },
        "candidateSha256": { "$ref": "#/$defs/sha256" },
        "baseHead": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "head": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }
      }
    },
    "changedPaths": { "type": "array", "items": { "$ref": "#/$defs/repositoryPath" }, "uniqueItems": true },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "claimClass", "acceptanceOwner", "evidenceClass", "resolvedSubject", "result", "evidenceRefs", "externalHumanReceipt"],
        "properties": {
          "claimId": { "type": "string", "pattern": "^claim:[a-z0-9][a-z0-9._-]*$" },
          "claimClass": { "type": "string", "pattern": "^claim-class:[a-z0-9][a-z0-9._-]*$" },
          "acceptanceOwner": { "enum": ["machine", "external_human"] },
          "evidenceClass": { "type": "string", "minLength": 1 },
          "resolvedSubject": { "$ref": "#/$defs/resolvedSubject" },
          "result": { "enum": ["passed", "failed", "not_evaluated", "inconclusive"] },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "pattern": "^evidence:[a-z0-9][a-z0-9._-]*$" }, "uniqueItems": true },
          "externalHumanReceipt": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["id", "path", "sha256", "schemaVersion"],
            "properties": {
              "id": { "type": "string", "pattern": "^human-receipt:[a-z0-9][a-z0-9._-]*$" },
              "path": { "$ref": "#/$defs/repositoryPath" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "schemaVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
            }
          }
        }
      }
    },
    "evidenceManifest": { "$ref": "#/$defs/immutableReference" },
    "openHumanClaims": { "type": "array", "items": { "type": "string", "pattern": "^claim:[a-z0-9][a-z0-9._-]*$" }, "uniqueItems": true },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextTokens", "outputTokens", "retrievals", "sequentialToolCalls", "totalToolCalls", "attempts", "spawns", "wallSeconds", "costUsd", "resourceEnvelope", "resourceObservation"],
      "properties": {
        "contextTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "retrievals": { "type": ["integer", "null"], "minimum": 0 },
        "sequentialToolCalls": { "type": ["integer", "null"], "minimum": 0 },
        "totalToolCalls": { "type": ["integer", "null"], "minimum": 0 },
        "attempts": { "type": ["integer", "null"], "minimum": 0 },
        "spawns": { "type": ["integer", "null"], "minimum": 0 },
        "wallSeconds": { "type": ["number", "null"], "minimum": 0 },
        "costUsd": { "type": ["number", "null"], "minimum": 0 },
        "resourceEnvelope": { "type": "string", "pattern": "^resource-envelope:[a-z0-9][a-z0-9._-]*$" },
        "resourceObservation": { "type": ["string", "null"] }
      }
    },
    "firstCausalFailure": { "type": ["string", "null"] },
    "finalizationState": { "enum": ["not_started", "candidate_checkpoint", "technical_evidence_green", "await_external_human_receipt", "finalized_on_candidate"] },
    "requestedNextAction": { "enum": ["none", "supply_context", "fix_causal_layer", "external_human_review", "independent_verification", "prepare_promotion", "owner_decision"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*:)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?(?:/|$))[^/\\x00-\\x1F<>\"|?*]+(?:/[^/\\x00-\\x1F<>\"|?*]+)*$"
    },
    "immutableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "optionalImmutableReference": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^receipt:[a-z0-9][a-z0-9._-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "resolvedSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repositoryId", "id", "baseHead", "sha256"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._-]*$" },
        "id": { "type": "string", "minLength": 1 },
        "baseHead": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
