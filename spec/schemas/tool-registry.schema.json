{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elad:schema:tool-registry:0.5",
  "title": "Tool Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "state", "ownerRepositoryId", "protocolBundle", "tools"],
  "properties": {
    "schemaVersion": { "const": "0.5" },
    "registryId": { "type": "string", "pattern": "^tool-registry:[a-z0-9][a-z0-9._-]*$" },
    "state": { "enum": ["template_inert", "inactive", "active", "superseded"] },
    "ownerRepositoryId": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._-]*$" },
    "protocolBundle": { "$ref": "#/$defs/immutableReference" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["toolId", "state", "entrySha256", "effect", "inputSchema", "outputSchema"],
        "properties": {
          "toolId": { "type": "string", "pattern": "^tool:[a-z0-9][a-z0-9._-]*$" },
          "state": { "enum": ["placeholder", "inactive", "active"] },
          "entrySha256": { "$ref": "#/$defs/sha256" },
          "effect": { "enum": ["read", "candidate_write", "target_native_write", "runtime_process", "data_write"] },
          "inputSchema": { "$ref": "#/$defs/immutableReference" },
          "outputSchema": { "$ref": "#/$defs/immutableReference" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "repositoryPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*:)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?(?:/|$))[^/\\x00-\\x1F<>\"|?*]+(?:/[^/\\x00-\\x1F<>\"|?*]+)*$" },
    "immutableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    }
  }
}
