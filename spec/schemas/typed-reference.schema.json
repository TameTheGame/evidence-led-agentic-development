{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elad:schema:typed-reference:0.3.0",
  "title": "Typed Immutable Reference",
  "description": "A provider-neutral reference to canonical JSON or exact raw bytes. This record grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "path",
    "bytes",
    "sha256",
    "schemaVersion",
    "digestMode"
  ],
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*:)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?(?:/|$))[^/\\x00-\\x1F<>\"|?*]+(?:/[^/\\x00-\\x1F<>\"|?*]+)*$"
    }
  },
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "active_authority",
        "adapter_lock",
        "adoption_efficacy_plan",
        "adoption_efficacy_report",
        "capability_certificate",
        "context_delivery",
        "continuation_anchor",
        "core_lock",
        "data_policy",
        "evaluation_pack",
        "evaluation_result_manifest",
        "evaluator_pack",
        "evaluator_registry",
        "evidence_manifest",
        "evidence_policy",
        "external_human_receipt",
        "harness_lock",
        "intent_brief",
        "json_schema",
        "project_profile",
        "protocol_bundle",
        "raw_payload",
        "registry",
        "resource_envelope",
        "retrieval_manifest",
        "review_bundle",
        "risk_policy",
        "runtime_lock",
        "task_packet",
        "tool_contract",
        "tool_registry",
        "worker_receipt",
        "writer_profile"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]*$"
    },
    "path": {
      "$ref": "#/$defs/repositoryPath"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "schemaVersion": {
      "const": "0.3.0"
    },
    "digestMode": {
      "enum": [
        "canonical_json",
        "raw_bytes"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "raw_payload"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "digestMode": {
            "const": "raw_bytes"
          }
        }
      },
      "else": {
        "properties": {
          "digestMode": {
            "const": "canonical_json"
          }
        }
      }
    }
  ]
}
