{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elad:schema:retrieval-manifest:0.5",
  "title": "Retrieval Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "state",
    "protocolBundle",
    "subject",
    "framing",
    "entries",
    "createdAt",
    "supersedes"
  ],
  "properties": {
    "schemaVersion": { "const": "0.5" },
    "manifestId": { "type": "string", "pattern": "^retrieval-manifest:[a-z0-9][a-z0-9._-]*$" },
    "state": { "enum": ["template_inert", "draft", "frozen", "superseded"] },
    "protocolBundle": { "$ref": "#/$defs/immutableReference" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "baseRef", "baseHead", "projectProfile", "authority"],
      "properties": {
        "repositoryId": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._-]*$" },
        "baseRef": { "type": "string", "minLength": 1 },
        "baseHead": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "projectProfile": { "$ref": "#/$defs/immutableReference" },
        "authority": { "$ref": "#/$defs/immutableReference" }
      }
    },
    "framing": { "const": "elad-canonical-json-outer-sha256-v1" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repositoryId", "path", "bytes", "sha256", "role", "slice", "freshness", "workerAccess"],
        "properties": {
          "repositoryId": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._-]*$" },
          "path": { "$ref": "#/$defs/repositoryPath" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "role": { "type": "string", "minLength": 1 },
          "slice": { "type": ["string", "null"] },
          "freshness": { "enum": ["frozen", "current_at_base", "superseded"] },
          "workerAccess": { "enum": ["prebundled", "manifest_bounded_retrieval", "forbidden"] }
        }
      }
    },
    "createdAt": { "type": ["string", "null"], "format": "date-time" },
    "supersedes": { "$ref": "#/$defs/optionalImmutableReference" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*:)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?(?:/|$))[^/\\x00-\\x1F<>\"|?*]+(?:/[^/\\x00-\\x1F<>\"|?*]+)*$"
    },
    "immutableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "optionalImmutableReference": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^retrieval-manifest:[a-z0-9][a-z0-9._-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    }
  }
}
