{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elad:schema:project-profile:0.5",
  "title": "Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "state",
    "repositoryId",
    "protocolBundle",
    "authority",
    "policyBindings",
    "artifactLanes",
    "allowedRoots",
    "humanOnlyDecisions",
    "targetOperations"
  ],
  "properties": {
    "schemaVersion": { "const": "0.5" },
    "profileId": { "type": "string", "pattern": "^project:[a-z0-9][a-z0-9._-]*$" },
    "state": { "enum": ["template_inert", "inactive", "active", "superseded"] },
    "repositoryId": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._-]*$" },
    "protocolBundle": { "$ref": "#/$defs/immutableReference" },
    "authority": { "$ref": "#/$defs/immutableReference" },
    "policyBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "data", "evidence", "toolRegistry", "evaluatorRegistry"],
      "properties": {
        "risk": { "$ref": "#/$defs/immutableReference" },
        "data": { "$ref": "#/$defs/immutableReference" },
        "evidence": { "$ref": "#/$defs/immutableReference" },
        "toolRegistry": { "$ref": "#/$defs/immutableReference" },
        "evaluatorRegistry": { "$ref": "#/$defs/immutableReference" }
      }
    },
    "artifactLanes": {
      "type": "array",
      "items": { "enum": ["ordinary_source", "target_native", "runtime", "external_human"] },
      "uniqueItems": true,
      "minItems": 1
    },
    "allowedRoots": {
      "type": "array",
      "items": { "$ref": "#/$defs/repositoryPath" },
      "uniqueItems": true
    },
    "humanOnlyDecisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "targetOperations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "state", "effects"],
        "properties": {
          "operationId": { "type": "string", "pattern": "^operation:[a-z0-9][a-z0-9._-]*$" },
          "state": { "enum": ["placeholder", "inactive", "active"] },
          "effects": {
            "type": "array",
            "items": { "enum": ["read", "candidate_write", "target_native_write", "runtime_process", "data_write"] },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "description": "Forward-slash repository-relative path. Schema and semantic validation use this same grammar: Unicode, interior spaces, and ordinary symbols are allowed; structural aliases and Windows device-name components are rejected. Case-fold collisions and resolved escapes are checked across path sets.",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*:)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?(?:/|$))[^/\\x00-\\x1F<>\"|?*]+(?:/[^/\\x00-\\x1F<>\"|?*]+)*$"
    },
    "immutableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    }
  }
}
