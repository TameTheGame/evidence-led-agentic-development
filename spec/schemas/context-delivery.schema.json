{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elad:schema:context-delivery:0.5",
  "title": "Context Delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "state",
    "protocolBundle",
    "packet",
    "retrievalManifest",
    "framing",
    "segments",
    "compiledArtifact",
    "accounting",
    "createdAt",
    "supersedes"
  ],
  "properties": {
    "schemaVersion": { "const": "0.5" },
    "bundleId": { "type": "string", "pattern": "^context-delivery:[a-z0-9][a-z0-9._-]*$" },
    "state": { "enum": ["template_inert", "sealed", "superseded"] },
    "protocolBundle": { "$ref": "#/$defs/immutableReference" },
    "packet": { "$ref": "#/$defs/immutableReference" },
    "retrievalManifest": { "$ref": "#/$defs/immutableReference" },
    "framing": { "const": "elad-model-visible-context-v1" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "segmentId", "channel", "origin", "delivered"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 0 },
          "segmentId": { "type": "string", "pattern": "^context-segment:[a-z0-9][a-z0-9._-]*$" },
          "channel": { "enum": ["system", "developer", "user", "tool_schema", "output_schema", "retrieval"] },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "path", "bytes", "sha256"],
            "properties": {
              "kind": { "enum": ["contract_artifact", "retrieval_entry"] },
              "id": { "type": "string", "minLength": 1 },
              "path": { "$ref": "#/$defs/repositoryPath" },
              "bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          },
          "delivered": { "$ref": "#/$defs/rawArtifact" }
        }
      }
    },
    "compiledArtifact": { "$ref": "#/$defs/rawArtifact" },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "counterToolId",
        "counterRegistryEntrySha256",
        "inputTokens",
        "outputReserveTokens",
        "requiredContextTokens"
      ],
      "properties": {
        "methodId": { "type": "string", "pattern": "^context-accounting:[a-z0-9][a-z0-9._-]*$" },
        "counterToolId": { "type": "string", "pattern": "^tool:[a-z0-9][a-z0-9._-]*$" },
        "counterRegistryEntrySha256": { "$ref": "#/$defs/sha256" },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputReserveTokens": { "type": "integer", "minimum": 0 },
        "requiredContextTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "createdAt": { "type": ["string", "null"], "format": "date-time" },
    "supersedes": { "$ref": "#/$defs/optionalImmutableReference" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*:)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?(?:/|$))[^/\\x00-\\x1F<>\"|?*]+(?:/[^/\\x00-\\x1F<>\"|?*]+)*$"
    },
    "immutableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "const": "0.5" }
      }
    },
    "optionalImmutableReference": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^context-delivery:[a-z0-9][a-z0-9._-]*$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schemaVersion": { "const": "0.5" }
      }
    },
    "rawArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
